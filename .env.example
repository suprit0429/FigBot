# ============================================================
# FigBot AI Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# Required: Groq API key for LLM inference
# Get one free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: HuggingFace token (increases rate limits for model downloads)
# Get one at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_ACCESS_TOKEN=your_huggingface_token_here
